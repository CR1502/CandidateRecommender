# Copy to .env and uncomment to override defaults (see src/candidate_recommender/config.py).

# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:12b        # or qwen3:8b, or hf.co/<org>/<repo>:<quant>
# OLLAMA_TIMEOUT=180
# LLM_NUM_CTX=6144
# LLM_CONCURRENCY=1              # raise on machines with memory to spare
# REDACT_PII=true                # hide names/contact details/location from the LLM
# SCORING_WEIGHTS={"semantic": 0.60, "skill_coverage": 0.30, "experience": 0.10}
# MAX_FILE_SIZE_MB=10
# MAX_FILES_PER_UPLOAD=20
# TOP_CANDIDATES_COUNT=10
# LOG_LEVEL=INFO
